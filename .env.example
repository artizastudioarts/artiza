# Copy this file to .env.local for local development.
# In production (Vercel), add each of these under Project Settings -> Environment Variables.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: Developers -> API keys
STRIPE_SECRET_KEY=
# Stripe: Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=

# Your own password for /admin — make it long and unique
ADMIN_PASSWORD=

# Your site's live URL, e.g. https://yourshop.com (used as a fallback for redirects)
SITE_URL=http://localhost:3000
